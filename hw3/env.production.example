# HW3 production VM configuration template.
# Copy this file to ~/tartan-tickets/.env.production on the VM and replace every
# CHANGE_ME value with a strong value. Never commit the real .env.production.

# Main application database
POSTGRES_USER=tartan
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tartantickets

# Seeded application accounts
TARTAN_ADMIN_EMAIL=admin@cmu.edu
TARTAN_ADMIN_PASSWORD=CHANGE_ME
TARTAN_ADMIN_NAME=Admin
STUDENT_FIXTURE_PASSWORD=CHANGE_ME
RELEASE_OPERATOR_PASSWORD=CHANGE_ME
SUPPORT_AGENT_PASSWORD=CHANGE_ME

# Authentication/application
JWT_SECRET=CHANGE_ME
SMTP_FROM=noreply@tartantickets.cmu.edu
APP_URL=https://17643-team11.s3d.cmu.edu

# Mailpit UI protection. Format: user:password (for example admin:<random>).
MP_UI_AUTH=CHANGE_ME

# External course-provided TartanPay service and its database
PAYMENT_SERVICE_IMAGE=ghcr.io/cmu-devops/tartanpay:latest
PAYMENT_DB_USER=tartanpay
PAYMENT_DB_PASSWORD=CHANGE_ME
PAYMENT_DB_NAME=tartanpay
# Must start with tp_sk_ or TartanPay rejects it (for example tp_sk_prod_<random>).
TARTANPAY_API_KEY=CHANGE_ME
TARTANPAY_ADMIN_TOKEN=CHANGE_ME
TARTANPAY_LOG_SECRETS=false

# Production ingress. Caddy obtains/renews TLS for this hostname.
CADDY_SITE_ADDRESS=17643-team11.s3d.cmu.edu
